[node name="HeaderHelp" type="Label" parent="Margin/Main"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.82, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "El HUD en juego toma las poses desde esta escena. Árbol: Margin/Main/WeaponsRow → columna → SlotHost/HudWeaponSlot1/WeaponIcon (offset, escala, rotación por arma). El borde cyan copia el tamaño del slot grande del WeaponHud."
autowrap_mode = 3

[node name="StatusLine" type="Label" parent="Margin/Main"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.88, 1, 1)
theme_override_font_sizes/font_size = 13
text = "Cuadro cyan = mismo tamaño que HudWeaponSlot1 del WeaponHud (actualízalo abriendo esta escena). Esas mismas poses se cargan en el HUD en runtime."

