[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/ui/achievements_screen.gd" id="1_script"]

[node name="AchievementsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
